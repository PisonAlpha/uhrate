# Copy to mobile/.env.local (git-ignored) for local development, then restart
# Expo with `npx expo start --tunnel -c`. EXPO_PUBLIC_* values are built into
# the app and readable by anyone, so never put secrets here.
#
# Builds made with EAS (eas.json) don't read .env.local: the preview and
# production profiles set the API address and flags themselves, and
# EXPO_PUBLIC_REOWN_PROJECT_ID comes from the project's EAS environment
# variables (eas env:create).

# The UHRATE Next.js API. Local server through a tunnel, a LAN address
# (http://192.168.1.23:3000) or production (https://uhrate.online).
EXPO_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com

# Reown (WalletConnect) project ID from cloud.reown.com, for wallet sign-in
# and payments.
EXPO_PUBLIC_REOWN_PROJECT_ID=

# true shows Seal, registering in the registries and Pricing, which charge
# the on-chain fee from the user's wallet. Off in store builds (app store
# payment rules); those features stay on the website.
EXPO_PUBLIC_ENABLE_ONCHAIN=false

# true adds BNB Testnet (free test BNB) to the blockchain choices. The server
# needs NEXT_PUBLIC_ENABLE_TESTNET=true too.
EXPO_PUBLIC_ENABLE_TESTNET=false
